# GovScheme Backend Environment Configuration

# Flask Environment: development | production
FLASK_ENV=production
PORT=5000
DEBUG=False

# Security Keys
SECRET_KEY=govscheme-super-secret-key-change-in-prod-2026
JWT_SECRET_KEY=govscheme-jwt-secret-key-32bytes-secure

# MongoDB Atlas Cloud Database
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/govscheme?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:YourStrongPassword@cluster0.abcde.mongodb.net/govscheme?retryWrites=true&w=majority
DB_NAME=govscheme

# Frontend Origin for CORS
FRONTEND_URL=https://govscheme.vercel.app
